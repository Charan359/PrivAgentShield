# ==============================================================================
# PRIVAGENTSHIELD ENVIRONMENT CONFIGURATION
# Phase 3 — Research Experimental Platform
# ==============================================================================
# NEVER commit actual credentials or API keys.
# All default experiments use SYNTHETIC data — no real PII required.

# ── Application ────────────────────────────────────────────────────────────────
VITE_APP_ENV=simulation          # simulation | experiment | production
VITE_PORT=5173

# ── LRI* Thresholds ─────────────────────────────────────────────────────────────
VITE_LRI_TAU_LOW=0.30
VITE_LRI_TAU_HIGH=0.70

# ── Experiment Engine ──────────────────────────────────────────────────────────
EXPERIMENT_WORKERS=1             # Number of parallel experiment workers
EXPERIMENT_TIMEOUT=30000         # Timeout per experiment (ms)
EXPERIMENT_DEFAULT_SEED=42       # Default random seed for reproducibility

# ── Model Provider (optional — mock used by default) ──────────────────────────
MODEL_PROVIDER=mock              # mock | openai | local
MODEL_NAME=gpt-4o-mini           # Model identifier (only used if provider != mock)
MODEL_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=                  # Leave blank to use mock agents
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=2048
MODEL_TIMEOUT=30000

# ── External Benchmark Adapters (optional) ────────────────────────────────────
# Install AgentLeak separately: https://github.com/example/agentleak
AGENTLEAK_PATH=                  # Path to AgentLeak installation (blank = NOT_CONFIGURED)
AGENTLEAK_DATASET=               # Path to AgentLeak dataset
AGENTLEAK_VERSION=               # AgentLeak version for reproducibility metadata
AGENTLEAK_COMMAND=python run.py  # Command to execute AgentLeak
AGENTLEAK_TIMEOUT=60000

# Install AgentDojo separately: https://github.com/ethz-spylab/agentdojo
AGENTDOJO_PATH=                  # Path to AgentDojo installation (blank = NOT_CONFIGURED)
AGENTDOJO_TIMEOUT=60000

# ── Detection Pipeline ────────────────────────────────────────────────────────
PRESIDIO_ANALYZER_URL=http://localhost:5001    # Optional: Microsoft Presidio Tier 2
PRESIDIO_ANONYMIZER_URL=http://localhost:5002  # Optional: Microsoft Presidio anonymizer

# ── Database (optional — in-memory store used by default) ──────────────────────
DATABASE_URL=                    # postgresql://user:password@localhost:5432/privagentshield

# ── Runtime Proxy ─────────────────────────────────────────────────────────────
FASTAPI_PROXY_URL=http://localhost:8000   # Optional: FastAPI HTTP proxy adapter
